# Public URL of the Supabase project used by the browser.
NEXT_PUBLIC_SUPABASE_URL=

# Public anonymous key of the same Supabase project.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY: never expose, log, commit, or import this value from browser code.
SUPABASE_SERVICE_ROLE_KEY=

# SERVER ONLY: Qonto API login. Leave both Qonto values empty to keep the connector disabled.
QONTO_LOGIN=

# SERVER ONLY: Qonto API secret key. Never expose, log, or commit a real value.
QONTO_SECRET_KEY=

# SERVER ONLY: optional direct integrations. See /integrations/setup and docs/DIRECT_INTEGRATIONS.md.
PENNYLANE_API_TOKEN=
REVOLUT_CLIENT_ID=
REVOLUT_REFRESH_TOKEN=
REVOLUT_ISSUER=
# PEM RSA private key, quoted with escaped \n between lines.
REVOLUT_PRIVATE_KEY=
BUNQ_API_KEY=
# Optional absolute path to private persistent auth context; default .libra/bunq-context.json.
BUNQ_CONTEXT_PATH=
