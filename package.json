{
  "name": "freelance-cashflow",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "pnpm --filter @fc/web dev",
    "build": "pnpm -r build",
    "check:supabase-cli": "node scripts/check-supabase-cli-version.mjs",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:run": "pnpm -r test:run && pnpm test:tooling",
    "test:tooling": "node --test scripts/*.test.mjs",
    "e2e": "pnpm --filter @fc/web e2e",
    "test:isolated": "node scripts/run-isolated-tests.mjs all",
    "test:client-boundary": "node scripts/run-isolated-tests.mjs build"
  },
  "devDependencies": {
    "yaml": "2.9.0"
  }
}
